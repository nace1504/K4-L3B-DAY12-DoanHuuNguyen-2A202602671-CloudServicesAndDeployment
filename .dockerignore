# CP2 — file này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git
.git
.gitignore

# Secret
.env

# Python cache và môi trường ảo
**/__pycache__
**/*.pyc
.venv
.pytest_cache

# Chỉ dùng lúc dev, image không cần
tests
screenshots
Dockerfile.single
